# Mã quản trị cho /admin/templates và các API ghi template (header x-admin-token).
# Khi không đặt: môi trường dev dùng "dev-admin-token", production tắt chức năng quản trị.
ADMIN_TOKEN=change-me

# (Tuỳ chọn) Đường dẫn file SQLite. Mặc định: ./data/app.db (trên Vercel: /tmp).
# DATABASE_PATH=./data/app.db

# (Tuỳ chọn) Thư mục lưu file gốc của template. Mặc định: ./data/storage
# STORAGE_DIR=./data/storage
